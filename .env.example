# Copy to .env at the repo root and fill in. settings.py reads .env automatically on import;
# variables already set in your shell take priority over .env.
# .env is gitignored; this file is committed and holds placeholders only.

# Bedrock model (inference profile ID, needs the "us." prefix). Default: Claude Sonnet 4.6.
ADJ_MODEL_ID=us.anthropic.claude-sonnet-4-6
ADJ_AWS_REGION=us-east-1
# Cap on Bedrock calls per run (read by Track C's agents/evidence.py). 0 = dry run, no calls.
ADJ_MAX_BEDROCK_CALLS=20

# Reviewer sign-in tokens, name:token pairs. Placeholder only; never commit real tokens.
ADJ_REVIEWER_TOKENS=jesus:change-me

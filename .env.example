# Copy to .env at the repo root and fill in. settings.py reads .env automatically on import;
# variables already set in your shell take priority over .env.
# .env is gitignored; this file is committed and holds placeholders only.

# Bedrock model (inference profile ID, needs the "us." prefix). Default: Claude Sonnet 4.6.
ADJ_MODEL_ID=us.anthropic.claude-sonnet-4-6
ADJ_AWS_REGION=us-east-1
# Cap on Bedrock calls per run (read by Track C's agents/evidence.py). 0 = dry run, no calls.
ADJ_MAX_BEDROCK_CALLS=20
# Only these finding IDs get FOR/AGAINST calls (comma-separated). Empty = all grey findings.
# Example: ADJ_EVIDENCE_ONLY=F-before-home-el0210-2.4.4,F-before-home-el0194-2.1.1
ADJ_EVIDENCE_ONLY=

# PULSE (pulse/api.py). Reviewer sign-in tokens, name:token pairs, comma-separated.
# Placeholder only; never commit real tokens. The API ignores any token shorter than 16
# characters, so this placeholder signs nobody in until you replace it. Make a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADJ_REVIEWER_TOKENS=jesus:change-me
# The PULSE extension's origin, allowed by CORS. Its ID is on chrome://extensions.
# ADJ_EXTENSION_ORIGIN=chrome-extension://<extension id>
# Set to 1 to serve FastAPI's /docs page (off by default).
# ADJ_PULSE_DOCS=1

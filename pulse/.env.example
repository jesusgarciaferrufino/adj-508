# PULSE review API settings (Track F). Placeholders only: never put a real token in this file.
#
# Copy these lines into the .env file at the repo root (it is gitignored) and fill them in.
# pulse/api.py reads them from the environment, or from that .env when a variable is not set.
# Write each one as KEY=value on its own line, with no spaces around the = sign.

# Who may record decisions: comma-separated name:token pairs. Tokens shorter than 16 characters
# are ignored, so these placeholders cannot sign anyone in. Make each token long and random,
# for example with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADJ_REVIEWER_TOKENS=jesus:change-me,daniel:change-me-too

# The browser extension's origin, the only site besides http://localhost:8000 that CORS lets
# call the API. Find the id on chrome://extensions after loading the unpacked extension.
ADJ_EXTENSION_ORIGIN=chrome-extension://your-extension-id-here

# Optional: set to 1 to serve FastAPI's interactive /docs page while developing (off by default).
# ADJ_PULSE_DOCS=1
